if SENSOR

config FRI3D_EXPANDER_BATTERY
	bool "Fri3d Badge 2026 I/O coprocessor battery voltage"
	default y
	depends on DT_HAS_FRI3D_BADGE_2026_EXPANDER_SENSOR_ENABLED
	depends on MULTITHREADING # the MFD uses a mutex, work items and sleeps
	select MFD
	help
	  Battery voltage of the Fri3d Camp 2026 badge, measured by its I/O
	  coprocessor.

endif # SENSOR
