if LED

config LED_FRI3D_EXPANDER
	bool "Fri3d Badge 2026 I/O coprocessor LEDs"
	default y
	depends on DT_HAS_FRI3D_BADGE_2026_EXPANDER_LED_ENABLED
	depends on MULTITHREADING # the MFD uses a mutex, work items and sleeps
	select MFD
	help
	  LCD backlight and debug LED of the Fri3d Camp 2026 badge, driven by
	  its I/O coprocessor.

config LED_FRI3D_EXPANDER_INIT_PRIORITY
	int "Initialization priority"
	default LED_INIT_PRIORITY
	depends on LED_FRI3D_EXPANDER

endif # LED
